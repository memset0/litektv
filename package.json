{
  "name": "litektv",
  "private": true,
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm --filter litektv-backend dev",
    "build": "pnpm --filter litektv-frontend build && pnpm --filter litektv-backend build",
    "start": "pnpm --filter litektv-backend start",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r --parallel test"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild"]
  }
}
