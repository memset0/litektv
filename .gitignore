# SQLite live data — kept at the legacy backend/data/ path (the user wants
# the database file to stay where it was even after the packages/ move) but
# must never be committed. Anchored with a leading slash so it only matches
# the top-level backend/ dir, not packages/backend/.
/backend/

# pnpm workspace install artefacts
node_modules/
**/node_modules/

# Frontend build output (Vite)
packages/frontend/dist/

# Backend compiled output
packages/backend/dist/

# OS / editor noise
.DS_Store
*.swp
